;; bjostat-plot/examples/cars.bjo — R's cars, the stopping distances of 50
;; cars by their speed, as three charts: the points with the line of a
;; linear model through them, a histogram of the distances, and the counts
;; of bands of speed.
;;
;;     bjo run examples/cars.bjo [directory]
;;
;; Writes cars-model, cars-histogram and cars-bands into the directory, the
;; current one by default: as .svg where vl-convert is installed, and as
;; .vl.json, which any Vega-Lite viewer draws, where it is not.

(import (std prelude))
(import (only (std maths) round))
(import (bjostat table))
(import (bjostat query))
(import (bjostat models))
(import (bjostat plot chart))
(import (bjostat plot save))

(: (Vec double))
(def speed [4.0 4.0 7.0 7.0 8.0 9.0 10.0 10.0 10.0 11.0 11.0 12.0 12.0 12.0 12.0 13.0 13.0 13.0 13.0 14.0 14.0
            14.0 14.0 15.0 15.0 15.0 16.0 16.0 17.0 17.0 17.0 18.0 18.0 18.0 18.0 19.0 19.0 19.0 20.0 20.0 20.0
            20.0 20.0 22.0 23.0 24.0 24.0 24.0 24.0 25.0])
(: (Vec double))
(def dist [2.0 10.0 4.0 22.0 16.0 10.0 18.0 26.0 34.0 17.0 28.0 14.0 20.0 24.0 28.0 26.0 34.0 34.0 46.0 26.0
           36.0 60.0 80.0 20.0 26.0 54.0 32.0 40.0 32.0 40.0 50.0 42.0 56.0 76.0 84.0 36.0 46.0 68.0 32.0 48.0
           52.0 56.0 64.0 66.0 54.0 70.0 92.0 93.0 120.0 85.0])

(: (-> double string))
(defun (two-decimals x) (double->string (/ (round (* x 100.0)) 100.0)))

(: (-> double string))
(defun (band s)
  (cond ((< s 10.0) "slow") ((< s 18.0) "medium") (else "fast")))

(: (-> string (Result PlotError Unit)))
(defun (charts dir)
  (def cars (or-panic (make-table [(named "speed" (array->column (vec->array speed)))
                                   (named "dist" (array->column (vec->array dist)))])))
  ;; The model, and a table of its line: two points are a line.
  (def m (match (loop (:for s speed) (:for d dist) (:acc (simple-linear-model "speed" (Tuple d s))))
           ((Ok m) m) ((Err e) (panic! (displayed e)))))
  (def line (or-panic (make-table [(named "speed" (array->column (vec->array [4.0 25.0])))
                                   (named "dist" (array->column (vec->array [(model-predict m [4.0])
                                                                             (model-predict m [25.0])])))])))
  (def (Ok points) (scatter-plot cars "speed" "dist") :propagate)
  (def (Ok fit) (line-plot line "speed" "dist") :propagate)
  (def model (chart-title (layer [points fit])
                          (str "dist = " (two-decimals (vec-ref (record-ref m estimates) 0)) " + "
                               (two-decimals (vec-ref (record-ref m estimates) 1)) " speed")))
  (def (Ok histogram-chart) (histogram cars "dist" #:bins 12 #:title "Stopping distances") :propagate)
  ;; Bands of speed, counted, as a category in their order.
  (def banded (or-panic (table-with cars "band" {column-building (band s) (:for s speed)})))
  (def counted (or-panic (table-count (or-panic (table-categorize banded "band" #:levels ["slow" "medium" "fast"]))
                                      ["band"])))
  (def (Ok bands) (bar-plot counted "band" "n" #:title "Cars by speed") :propagate)
  (loop (:for (Tuple name c) [(Tuple "cars-model" model) (Tuple "cars-histogram" histogram-chart) (Tuple "cars-bands" bands)])
        (:do (match (save-chart c (str dir "/" name ".svg"))
               ((Ok _) (println (str "wrote " dir "/" name ".svg")))
               ((Err _)
                (match (save-chart c (str dir "/" name ".vl.json"))
                  ((Ok _) (println (str "wrote " dir "/" name ".vl.json")))
                  ((Err e) (println (displayed e))))))))
  (Ok unit))

(defun (main args)
  (match (charts (if (> (vec-length args) 0) (vec-ref args 0) "."))
    ((Ok _) 0)
    ((Err e) (println (displayed e)) 1)))
